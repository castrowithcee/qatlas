# Zone .qatlas/project/zone-import/: flüchtige Eingaben (Rohdateien, die der Agent verarbeitet) und ihr
# processed/-Archiv. Kein Teil der Wissensbasis, nicht versioniert. Der Ordner bleibt über .gitkeep
# bestehen, sein Inhalt wird ignoriert.
/.qatlas/project/zone-import/*
!/.qatlas/project/zone-import/.gitkeep

# Zone .qatlas/project/zone-export/: angeforderte Ergebnisse, die der Nutzer aus dem Repo entnimmt. Sie
# enthalten oft echte, ungeschwärzte Daten und dürfen deshalb nie versioniert werden. Der Ordner bleibt
# über .gitkeep bestehen, sein Inhalt wird ignoriert.
/.qatlas/project/zone-export/*
!/.qatlas/project/zone-export/.gitkeep

# Lokaler Qatlas-Laufzeitzustand gehört nur zu diesem Checkout.
/.qatlas/local/
