# Zone .qatlas-brain/zone-import/: transient input (raw files the agent processes) and its processed/
# archive. Not part of the knowledge base, never versioned. The folder may stay via .gitkeep; its content is
# ignored.
/.qatlas-brain/zone-import/*
!/.qatlas-brain/zone-import/.gitkeep

# Zone .qatlas-brain/zone-export/: requested deliverables the user takes out of the repo. They often hold
# real, unredacted data and must never be versioned. The folder arises with the first deliverable.
/.qatlas-brain/zone-export/*

# Project id and working files of agents belong to this checkout only.
/.qatlas/local/
